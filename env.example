# ============================================================
# GEODAILY — Variables de Entorno
# ============================================================
# Copia este archivo a .env y completa los valores
# ⚠️ ¡NUNCA comprometer .env en git!

# 🌐 Dominio público vía Cloudflare Tunnel — usar SIEMPRE este; funciona
# en LAN, datos móviles y campo. EAS lo inyecta también desde eas.json.
BACKEND_URL=https://geodaily-api.brysoftsas.com

# 🧪 Alternativa solo-LAN (únicamente si el túnel está caído)
# BACKEND_URL=http://192.168.1.20:8089
API_TIMEOUT=15000

# Google Maps
GOOGLE_MAPS_API_KEY=

# Expo
LOGBOX_ENABLED=false
