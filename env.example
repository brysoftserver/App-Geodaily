# ============================================================
# GEODAILY — Variables de Entorno
# ============================================================
# Copia este archivo a .env y completa los valores
# ⚠️ ¡NUNCA comprometer .env en git!

# 🏭 PRODUCCIÓN (usar para APK oficial vía EAS Build)
# EAS inyecta esto automáticamente desde eas.json build.production.env
# BACKEND_URL=https://api.geodaily.brysoftsas.com

# 🧪 DESARROLLO LOCAL (para expo start / tunel ngrok)
BACKEND_URL=http://192.168.1.20:8089
API_TIMEOUT=15000

# Google Maps
GOOGLE_MAPS_API_KEY=

# Expo
LOGBOX_ENABLED=false
