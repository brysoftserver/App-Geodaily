{
  "expo": {
    "name": "GEODAILY",
    "slug": "geodaily-app",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/logo_geo_daily.png",
    "iconBackground": "#0D3B0F",
    "scheme": "geodaily",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "metro": {
      "port": 8082
    },
    "splash": {
      "image": "./assets/images/fondo_login_geo_daily.png",
      "resizeMode": "cover",
      "backgroundColor": "#0D3B0F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.geodaily.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "GEODAILY necesita acceso a tu ubicación para georreferenciar los puntos de visita.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "GEODAILY necesita acceso a tu ubicación en segundo plano para registrar rutas.",
        "NSCameraUsageDescription": "GEODAILY necesita acceso a la cámara para capturar evidencia fotográfica.",
        "NSPhotoLibraryUsageDescription": "GEODAILY necesita acceso a la galería para adjuntar imágenes.",
        "NSFaceIDUsageDescription": "GEODAILY usa Face ID para autenticación biométrica."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo_geo_daily.png",
        "backgroundColor": "#0D3B0F"
      },
      "package": "com.geodaily.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "USE_BIOMETRIC",
        "INTERNET",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "USE_BIOMETRIC",
        "INTERNET",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "GOOGLE_MAPS_API_KEY"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-location",
      "expo-camera",
      "expo-secure-store",
      "expo-sqlite",
      "expo-local-authentication",
      "expo-file-system",
      "expo-updates",
      "@maplibre/maplibre-react-native",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-video"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f5fc7c36-3f1f-4f73-9265-7f7df5024f54",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 10000
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "f5fc7c36-3f1f-4f73-9265-7f7df5024f54"
      }
    }
  }
}
