{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "BACKEND_URL": "https://geodaily-api.brysoftsas.com",
        "API_TIMEOUT": "15000"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "BACKEND_URL": "https://geodaily-api.brysoftsas.com",
        "API_TIMEOUT": "15000"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "buildConfiguration": "Release"
      }
    },
    "production": {
      "distribution": "internal",
      "env": {
        "BACKEND_URL": "https://geodaily-api.brysoftsas.com",
        "API_TIMEOUT": "15000"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "buildConfiguration": "Release"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
