# ============================================================
# GEODAILY Backend — Variables de Entorno
# ============================================================
# Copia este archivo a .env (dentro de backend/) y completa los valores.
# ⚠️ ¡NUNCA comprometer .env en git!
# Todas estas variables son obligatorias: el servidor lanza un error
# al iniciar si alguna falta (ver auth.js, database.js, storage.js).

PORT=8089
HOST=0.0.0.0
UPLOAD_DIR=uploads

# JWT
JWT_SECRET=

# Para producción:
# PROD_DOMAIN=https://geodaily-api.brysoftsas.com

# ============================================================
# PostgreSQL
# ============================================================
PG_HOST=localhost
PG_PORT=5432
PG_DB=geodaily
PG_USER=geodaily_admin
PG_PASSWORD=

# ============================================================
# MinIO (S3-compatible)
# ============================================================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET=
MINIO_BUCKET=geodaily-archivos
